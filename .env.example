# Environment read by the entry points. Placeholders only: never commit real values.
# Core settings use SANDLANE_*; settings of the Purefect plugin use PUREFECT_*.
# Any NAME_FILE variable may be replaced by NAME (inline value), never both; files must be 0600/0400.

# --- Worker (dist/bin/worker.js) ---
# Extra CA bundle (e.g. the Engine's TLS CA) for outbound HTTPS.
# NODE_EXTRA_CA_CERTS=/path/to/engine-ca.pem
# Runtime identifier reported to the control plane on claim.
SANDLANE_RUNTIME_ID=
# Comma-separated control plane queue lanes to claim from (default: interactive).
# SANDLANE_LANES=interactive
# Number of concurrent execution lanes, 1..16 (default: 1).
# SANDLANE_CONCURRENCY=1
# Host memory required before a lane claims work, in MiB (default: 0, disabled).
# SANDLANE_ADMISSION_MEMORY_MIB=0
# Comma-separated tools exposed to the CLI; default: all of them (platform permissions apply per
# user token). Set it only to narrow the set, e.g. drop workspace_action to disable page actions, or
# propose_task / report_task to disable in-conversation delegation.
# SANDLANE_ENABLED_TOOLS=purefect_call,list_api_docs,read_api_doc,read_skill,workspace_action,propose_task,report_task
# Model alias configured in the CLI; the gateway maps it to the Run's upstream model (default: sandlane).
# SANDLANE_MODEL_ALIAS=
# Per-turn reasoning effort: low, medium or high (default: model default).
# SANDLANE_REASONING_EFFORT=
# Grace period for running Runs on SIGTERM before they are cancelled, in ms (default: 60000).
# SANDLANE_DRAIN_MS=60000
# Optional memory plugin (single-host SQLite, see docs/memory-lite.md): off unless "true";
# then SANDLANE_MEMORY_DIRECTORY (absolute) and SANDLANE_MEMORY_TOPOLOGY=single-host are required.
# SANDLANE_MEMORY_ENABLED=
# SANDLANE_MEMORY_DIRECTORY=
# SANDLANE_MEMORY_TOPOLOGY=single-host
# Optional summary model of the memory plugin (Responses-compatible endpoint).
# SANDLANE_MEMORY_SUMMARY_BASE_URL=
# SANDLANE_MEMORY_SUMMARY_MODEL=
# SANDLANE_MEMORY_SUMMARY_KEY_FILE=
# Unix socket of the node-local Broker.
SANDLANE_BROKER_SOCKET=/control/broker.sock
# File holding the Broker service token (shared with the Broker).
SANDLANE_BROKER_SERVICE_TOKEN_FILE=/config/broker-token
# Node id the Broker must report (same value as the Broker's SANDLANE_BROKER_NODE_ID).
SANDLANE_BROKER_NODE_ID=
# Model gateway (Responses and Anthropic Messages over TLS) listen address and port.
SANDLANE_MODEL_GATEWAY_BIND=0.0.0.0
SANDLANE_MODEL_GATEWAY_PORT=19443
# Hostname the sandboxed CLI uses for the model gateway (must match the TLS certificate).
SANDLANE_MODEL_GATEWAY_HOSTNAME=
# Model gateway TLS private key and certificate files.
SANDLANE_MODEL_GATEWAY_TLS_KEY_FILE=/secrets/gateway-key.pem
SANDLANE_MODEL_GATEWAY_TLS_CERT_FILE=/secrets/gateway.pem
# JSON object of model-visible function names per harness, e.g. {"codex":[...],"claude-code":[...]}
# (default: derived from the enabled tools in each CLI's naming). An explicit inventory must list the
# enabled propose_task / report_task for every harness it names, or the Worker refuses to start.
# SANDLANE_MODEL_FUNCTION_INVENTORY=
# JSON object of built-in file functions admitted per harness while a Run is in file mode.
# SANDLANE_MODEL_FILE_FUNCTION_INVENTORY=
# How the Messages upstream receives the lease's key: x-api-key, bearer or both (default: x-api-key).
# SANDLANE_MODEL_MESSAGES_AUTH=x-api-key
# Upper bound for max_output_tokens per model call (default: 32000).
# SANDLANE_MODEL_MAX_OUTPUT_TOKENS=32000
# Timeout for one streamed model call, in ms (default: 600000).
# SANDLANE_MODEL_GATEWAY_TIMEOUT_MS=600000
# MCP tool gateway listen address and port.
SANDLANE_TOOL_MCP_BIND=0.0.0.0
SANDLANE_TOOL_MCP_PORT=19444
# Hostname the sandboxed CLI uses for the MCP gateway (must match the TLS certificate).
SANDLANE_TOOL_MCP_HOSTNAME=
# MCP gateway TLS private key and certificate files.
SANDLANE_TOOL_MCP_TLS_KEY_FILE=/secrets/gateway-key.pem
SANDLANE_TOOL_MCP_TLS_CERT_FILE=/secrets/gateway.pem
# Tool deployment target reference and version recorded on tool calls (default: tool server, 1).
# SANDLANE_TOOL_TARGET_REF=
# SANDLANE_TOOL_TARGET_VERSION=1
# Read-only status panel (docs/status-panel.md): off unless a port is set. Plain HTTP; keep it on
# loopback (in a container: bind 0.0.0.0 and publish as 127.0.0.1:<port>:<port>).
# SANDLANE_STATUS_PORT=19445
# SANDLANE_STATUS_BIND=127.0.0.1
# Optional access token (32..256 printable characters): Bearer header or ?token=.
# SANDLANE_STATUS_TOKEN_FILE=/secrets/status-token
# Run identifiers on the panel: hash (per-process keyed short hash), plain or none (default: hash).
# SANDLANE_STATUS_RUN_IDS=hash
# Finished Runs kept in memory, 1..500 (default: 50).
# SANDLANE_STATUS_RECENT_RUNS=50
# Extra Host names accepted besides IP literals and localhost, comma-separated (default: none).
# SANDLANE_STATUS_HOSTS=

# --- Purefect plugin (control plane, metadata tools, business prompt) ---
# Engine HTTPS origin used for claim/sync/complete.
PUREFECT_ENGINE_ORIGIN=https://engine.example.com
# Control-plane site and tenant segments of the Engine API path.
PUREFECT_CONTROL_SITE=
PUREFECT_CONTROL_TENANT=
# Service principal id and secret file used to authenticate against the Engine
# (the secret must differ from the Broker token).
PUREFECT_SERVICE_PRINCIPAL=
PUREFECT_SERVICE_SECRET_FILE=/secrets/service-secret
# Absolute path of the purefect-client module used by the metadata tools.
PUREFECT_CLIENT_MODULE=/opt/client/lib/client.js
# Origin the metadata tools call (default: PUREFECT_ENGINE_ORIGIN).
# PUREFECT_TOOL_ORIGIN=
# Base instruction profile: default or business (default: default).
# PUREFECT_INSTRUCTION_PROFILE=default

# --- Sandbox Broker (dist/bin/broker.js, Linux only) ---
# The Broker also reads SANDLANE_BROKER_NODE_ID, SANDLANE_BROKER_SOCKET and
# SANDLANE_BROKER_SERVICE_TOKEN_FILE above.
# Docker Engine Unix socket.
SANDLANE_BROKER_DOCKER_SOCKET=/var/run/docker.sock
# Docker Engine API version, v1.N (default: v1.45).
# SANDLANE_BROKER_DOCKER_API_VERSION=v1.45
# Numeric group allowed to use the control socket SANDLANE_BROKER_SOCKET (default: owner only).
# SANDLANE_BROKER_SOCKET_GROUP_ID=
# Private directory for the Broker's allocation ledger and lock.
SANDLANE_BROKER_STATE_DIR=/state
# JSON object: harness id -> CLI image pinned by sha256 digest. A harness without an image is
# refused on this node (the Run fails as harness_unavailable).
SANDLANE_BROKER_RUN_IMAGES={"codex":"registry.example.com/codex-cli@sha256:<digest>"}
# Container network: none or isolated (isolated requires a relay binding).
SANDLANE_BROKER_NETWORK_MODE=none
# Maximum concurrent allocations on this node, and per tenant (defaults: 5, 2).
# SANDLANE_BROKER_MAX_CONCURRENT=5
# SANDLANE_BROKER_PER_TENANT=2
# Workspace tmpfs size and optional per-harness container memory limits, in MiB.
# SANDLANE_BROKER_WORKSPACE_MIB=96
# SANDLANE_BROKER_RUN_MEMORY_MIB={"codex":512}
# Generated-output collection limits (defaults: 10 files, 10 MiB each, 30 MiB total).
# SANDLANE_BROKER_OUTPUT_MAX_FILES=10
# SANDLANE_BROKER_OUTPUT_FILE_MAX_MIB=10
# SANDLANE_BROKER_OUTPUT_TOTAL_MAX_MIB=30
# JSON relay container binding for the isolated network mode.
# SANDLANE_BROKER_RELAY_BINDING=
# JSON gateway policy {"modelBaseUrl":"https://<model host>:<port>/v1","mcpUrl":"https://<mcp host>:<port>/mcp"}
# (gateway URLs reachable through the relay).
# SANDLANE_BROKER_MANAGED_GATEWAYS=
# Reverse-DNS prefix of the Docker labels on Broker resources and the relay
# (default: cn.purefect.sandlane; the relay carries <prefix>.relay.node / <prefix>.relay.policy).
# SANDLANE_LABEL_PREFIX=cn.purefect.sandlane

# --- Gateway relay (dist/bin/relay.js) ---
# JSON array of {listenHost, listenPort, upstreamHost, upstreamPort} routes.
# SANDLANE_RELAY_ROUTES=
