# Build TypeScript first. This image contains only a fixed TCP relay, never a CLI.
ARG NODE_IMAGE=node:24-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6
FROM ${NODE_IMAGE}
WORKDIR /app
COPY LICENSE NOTICE ./
COPY dist/network/gateway-relay.js ./network/
COPY dist/bin/relay.js ./bin/
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/node"]
CMD ["/app/bin/relay.js"]
