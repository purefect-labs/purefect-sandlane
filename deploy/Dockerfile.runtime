# Build the control processes independently of the per-Run CLI image.
ARG NODE_IMAGE=node:24-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6
FROM ${NODE_IMAGE} AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund --fetch-retries=1 --fetch-timeout=60000
COPY src ./src
RUN npm run build && npm prune --omit=dev

FROM ${NODE_IMAGE}
WORKDIR /app
COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY package.json ./
COPY LICENSE NOTICE ./
COPY scripts/runtime-container-*.js ./scripts/
RUN mkdir -p /state /control /config /host-config \
    && chown 1000:1000 /state /control /config /host-config \
    && chmod 700 /state /control /config /host-config
USER 1000:1000
CMD ["node", "dist/bin/broker.js"]
