# Qwen Code is Apache-2.0 software distributed by its upstream project. This image installs an
# exact release and SandLane's small launch shim; Driver, Broker and Worker code remain outside.
ARG NODE_IMAGE=node:24-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6
FROM ${NODE_IMAGE}
ARG QWEN_CODE_VERSION=0.26.3
COPY LICENSE NOTICE /usr/share/doc/purefect-sandlane/
COPY deploy/harness-launch-shim.mjs /usr/local/lib/purefect-sandlane/harness-launch-shim.mjs
RUN node -e 'if (!/^\d+\.\d+\.\d+$/.test(process.argv[1])) process.exit(1)' "$QWEN_CODE_VERSION" \
    && npm install --global --ignore-scripts "@qwen-code/qwen-code@$QWEN_CODE_VERSION" \
    && qwen --version | grep -qF "$QWEN_CODE_VERSION" \
    && npm cache clean --force \
    && ln -s /usr/local/lib/purefect-sandlane/harness-launch-shim.mjs /usr/local/bin/sandlane-harness-shim \
    && chmod 0755 /usr/local/lib/purefect-sandlane/harness-launch-shim.mjs \
    && mkdir -p /home/runner /workspace \
    && chown -R 1000:1000 /home/runner /workspace
LABEL cn.purefect.sandlane.harness="qwen-code" cn.purefect.sandlane.cli-version="${QWEN_CODE_VERSION}"
ENV HOME=/home/runner
WORKDIR /workspace
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/sandlane-harness-shim"]
