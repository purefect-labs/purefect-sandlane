# SandLane node images and Docker socket group. Replace every placeholder with an approved digest.
RUNTIME_NODE_IMAGE=node@sha256:<64-hex-digest>
RUNTIME_DOCKER_GID=<docker-socket-gid>
RUNTIME_CLI_IMAGES={"codex":"sandlane/codex@sha256:<64-hex-digest>"}
SANDLANE_RELAY_IMAGE=sandlane/relay@sha256:<64-hex-digest>

# Node identity and capacity.
SANDLANE_RUNTIME_ID=<unique-runtime-id>
SANDLANE_LANES=interactive
SANDLANE_CONCURRENCY=1
SANDLANE_ADMISSION_MEMORY_MIB=1024
SANDLANE_BROKER_MAX_CONCURRENT=1
SANDLANE_BROKER_PER_TENANT=1
# Optional bounded CLI-native conversation state; keep disabled until the node passes baseline checks.
SANDLANE_NATIVE_SESSIONS=false

# Private managed network. Worker and Relay addresses must be distinct and inside the subnet.
SANDLANE_MANAGED_SUBNET=172.30.0.0/24
SANDLANE_WORKER_IP=172.30.0.2
SANDLANE_RELAY_IP=172.30.0.3
SANDLANE_MODEL_GATEWAY_HOSTNAME=sandlane-model.local
SANDLANE_MODEL_GATEWAY_PORT=19443
SANDLANE_TOOL_MCP_HOSTNAME=sandlane-mcp.local
SANDLANE_TOOL_MCP_PORT=19444
SANDLANE_STATUS_PORT=19445
SANDLANE_BROKER_MANAGED_GATEWAYS={"modelBaseUrl":"https://sandlane-model.local:19443/v1","mcpUrl":"https://sandlane-mcp.local:19444/mcp"}

# Purefect reference control plane. These identify routes and principals, never Secret values.
PUREFECT_ENGINE_ORIGIN=https://engine.example.com
PUREFECT_CONTROL_SITE=<site-code>
PUREFECT_CONTROL_TENANT=<tenant-code>
PUREFECT_SERVICE_PRINCIPAL=<service-principal-id>
PUREFECT_CLIENT_DIR=/opt/purefect-client
PUREFECT_INSTRUCTION_PROFILE=business

# Host directories. The Secret directory contains gateway-key.pem, gateway.pem and service-secret.
SANDLANE_EXECUTION_SECRETS_DIR=/etc/sandlane/secrets
# For a private Engine CA only, also mount it in compose.server.yaml and set the container path:
# SANDLANE_ENGINE_CA_CONTAINER_FILE=/host-config/engine-ca.pem
