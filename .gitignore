# Ignore local credentials, runtime data and reproducible build output.

# Dependencies
node_modules/

# Local configuration and credentials
.env*
!.env.example
.claude/settings.local.json

# Runtime state (runs, workspaces, and local Codex state)
.data/
.codex/
*.pid
*.pid.lock

# Test and build output
coverage/
.nyc_output/
dist/
build/
.cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and operating-system files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Local task notes (development records, not published)
.tasks/

# Temporary files and packaged archives
.release/
.tmp/
tmp/
temp/
*.tmp
*.tgz
